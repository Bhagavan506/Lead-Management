{
  "name": "@leadbook/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "db:migrate:prod": "node dist/db/migrate.js",
    "admin:create:prod": "node dist/db/create-admin.js",
    "push:keys": "tsx src/push/generate-keys.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "argon2": "^0.45.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.17",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  }
}
