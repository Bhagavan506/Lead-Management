{
  "name": "@leadbook/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.8",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
