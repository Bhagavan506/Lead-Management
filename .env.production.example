# Copy to .env.production and fill in. Never commit the real file.
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# The public https address people use, exactly as in the browser (no trailing slash)
PUBLIC_URL=https://leadbook.example.com
WEB_PORT=8080
APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=IN
# mock = records reminders only. push = browser notifications (docs/PUSH.md).
# meta = real WhatsApp (see docs/WHATSAPP.md; not verified live)
WHATSAPP_PROVIDER=mock
# Create with: pnpm --filter @leadbook/api push:keys  (keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-company.example
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
