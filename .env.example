# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://leadbook:leadbook@localhost:5432/leadbook
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# --- Business config (never hardcoded) ---
DEFAULT_COUNTRY_CODE=IN
APP_TIMEZONE=Asia/Kolkata

# --- Reminders ---
# mock | push | meta   (push = browser notifications, see docs/PUSH.md; meta = WhatsApp)
WHATSAPP_PROVIDER=mock
# Web Push keys. Create with: pnpm --filter @leadbook/api push:keys
# Needed for WHATSAPP_PROVIDER=push; when set they also enable "lead assigned" notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-company.example
# Only needed when WHATSAPP_PROVIDER=meta (Task 9.4)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# --- Web ---
# Where the Vite dev/preview server forwards /api and /health. The browser itself never uses this URL.
VITE_API_URL=http://localhost:3000

# Demo data only (pnpm db:seed). Never used in production.
SEED_PASSWORD=ChangeMe-Demo-123

# --- Security ---
# true only behind a reverse proxy you control (so rate limiting sees real client IPs)
TRUST_PROXY=false
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Set to false to disable the in-process reminder scheduler (tests, or a second instance)
SCHEDULER_ENABLED=true
