# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://leadbook:leadbook@localhost:5432/leadbook
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# --- Business config (never hardcoded) ---
DEFAULT_COUNTRY_CODE=IN
APP_TIMEZONE=Asia/Kolkata

# --- Reminders ---
# mock | meta
WHATSAPP_PROVIDER=mock
# Only needed when WHATSAPP_PROVIDER=meta (Task 9.4)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_APP_SECRET=

# --- Web ---
VITE_API_URL=http://localhost:3000

# Demo data only (pnpm db:seed). Never used in production.
SEED_PASSWORD=ChangeMe-Demo-123

# --- Security ---
# true only behind a reverse proxy you control (so rate limiting sees real client IPs)
TRUST_PROXY=false
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
