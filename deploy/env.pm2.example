# Settings for the pm2 deployment (docs/AWS.md). On the server:
#   cp deploy/env.pm2.example .env.production && chmod 600 .env.production
# then fill in every line marked CHANGE. Never commit .env.production.
NODE_ENV=production
PORT=3000

# CHANGE: the Neon connection string (the DIRECT one, host without "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# CHANGE: at least 32 characters. Create one with:  openssl rand -base64 48
JWT_SECRET=

# CHANGE: the https address people type, no trailing slash.
CORS_ORIGIN=https://leadbook.example.com

# HTTPS is terminated by Caddy in front of the API.
COOKIE_SECURE=true
TRUST_PROXY=true

APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=IN

# Reminders by browser push (docs/PUSH.md). CHANGE the keys: pnpm --filter @leadbook/api push:keys
WHATSAPP_PROVIDER=push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-company.example

# The daily reminder job runs inside the API process.
SCHEDULER_ENABLED=true
